# ============================================================================
# PayGuard: Zero-Trust Cryptographic Safety Layer for Agentic Commerce
# Environment Configuration Template
# ============================================================================

# --- PayPal Developer Platform (Sandbox) ---
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# --- LLM Intent Parser (Zero-Trust Isolated SKU + Qty Extractor) ---
# Provide EITHER Gemini API Key OR Groq API Key (or both; Gemini is primary, Groq is secondary)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cryptographic Step-Up Approval Engine (HMAC-SHA256) ---
# 256-bit secret key used to sign and verify 30-second single-use nonces
HMAC_SERVER_SECRET=payguard_zero_trust_hmac_sha256_secret_key_change_in_prod_9f86d081

# --- Database & Server Settings ---
SQLITE_DB_PATH=payguard.db
PORT=8000

# --- Frontend Settings (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
